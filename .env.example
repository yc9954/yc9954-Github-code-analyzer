# Frontend (Vite) environment variables. Copy to .env and adjust.
# All variables must be prefixed with VITE_ to be exposed to the browser.

# Base URL of the SprintGit REST API the browser talks to.
# Defaults to https://api.sprintgit.com when unset.
# Point it at the local Next.js proxy (server/) with: http://localhost:3000
VITE_API_URL=https://api.sprintgit.com

# Optional GitHub personal access token used only for the direct
# GET https://api.github.com/repos/{owner}/{repo}/branches call.
# Without it you get GitHub's unauthenticated limit (60 req/h per IP).
VITE_GITHUB_TOKEN=
